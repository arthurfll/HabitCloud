<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitCloud</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Core.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid justify-content-center position-relative">
                <a class="navbar-brand mb-0" asp-area="" asp-controller="Home" asp-action="Index">HabitCloud</a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-primary btn-sm position-absolute top-50 end-0 translate-middle-y me-3" asp-controller="Account" asp-action="Login">Entrar</a>
                }
            </div>
        </nav>
    </header>
    <div class="container @(User.Identity?.IsAuthenticated == true ? "pb-nav" : "")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        <nav class="bottom-nav fixed-bottom bg-white border-top">
            <div class="d-flex justify-content-around">
                <a class="bottom-nav-link @(currentPath == "/" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>
                <a class="bottom-nav-link @(currentPath.StartsWith("/habito") ? "active" : "")" asp-page="/Habito/Index">
                    <i class="bi bi-list-check"></i>
                    <span>Hábitos</span>
                </a>
                <a class="bottom-nav-link @(currentPath.StartsWith("/categoria") ? "active" : "")" asp-page="/Categoria/Index">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Categorias</span>
                </a>
                <a class="bottom-nav-link @(currentPath.StartsWith("/stats") ? "active" : "")" asp-page="/Stats/Index">
                    <i class="bi bi-graph-up"></i>
                    <span>Estatísticas</span>
                </a>
                <a class="bottom-nav-link @(currentPath.StartsWith("/perfil") ? "active" : "")" asp-page="/Perfil/Index">
                    <i class="bi bi-person"></i>
                    <span>Perfil</span>
                </a>
            </div>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
